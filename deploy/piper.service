# Runs Piper under systemd so it starts on boot and restarts if it dies.
# Install: sudo cp deploy/piper.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now piper

[Unit]
Description=Piper — wedding DJ CRM
After=network.target

[Service]
Type=simple
User=piper
WorkingDirectory=/srv/piper
Environment=NODE_ENV=production
Environment=PORT=3000
# The database lives outside the checkout, so a deploy can never delete it.
Environment=PIPER_DATA_DIR=/var/lib/piper
EnvironmentFile=-/etc/piper.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=3

# Piper only ever needs its own directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/piper /srv/piper/.next

[Install]
WantedBy=multi-user.target
